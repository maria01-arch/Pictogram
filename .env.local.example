# Copy to .env.local for local work. On Vercel, add the same names under
# Project -> Settings -> Environment Variables.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# --- Cloudflare R2 (post + story media) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=                        # no trailing slash

# --- OneSignal (push) ---
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                     # optional

# --- Wallpaper gallery ---
WALLHAVEN_API_KEY=

# --- Daily media clean-up job (Vercel Cron) ---
CRON_SECRET=                          # any long random string

# --- Optional ---
NEXT_PUBLIC_SITE_URL=                 # e.g. https://pictogram.xchord.space (used in push links)
NEXT_PUBLIC_ALLOW_VERIFICATION_PAYMENTS=   # set to "true" to show verification payments inside the app too
